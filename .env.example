GOOGLE_API_KEY=your-google-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
SUPABASE_TABLE=employees
SUPABASE_SEARCH_COLUMNS=name,department,location
GOOGLE_GENAI_USE_ENTERPRISE=False
# Optional. Render sets RENDER_EXTERNAL_URL for you.
# A2A_PUBLIC_URL=https://your-service.onrender.com
# Same Langfuse project as the policy app. Reachable from inside the container.
# EU cloud: https://cloud.langfuse.com
# US cloud: https://us.cloud.langfuse.com
# Langfuse on this machine: http://host.docker.internal:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
