# Streamlit page for the same agent.
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    GOOGLE_GENAI_USE_ENTERPRISE=False \
    PORT=8502

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY agent.py streamlit_app.py ./

EXPOSE 8502

CMD ["sh", "-c", "streamlit run streamlit_app.py --server.port ${PORT} --server.address 0.0.0.0 --server.headless true --server.enableCORS false --server.enableXsrfProtection false"]
